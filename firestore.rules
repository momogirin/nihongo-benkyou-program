rules_version = '2';

// Firebase 콘솔 → Firestore Database → 규칙 탭에 이 내용을 그대로 붙여넣기.
// (firebase-tools CLI 설치 없이 콘솔에서 바로 적용 가능)
//
// 각 로그인 사용자는 /users/{자기 uid} 문서 하나만 읽고 쓸 수 있음 — 다른
// 사용자의 학습 진도는 절대 못 봄. src/lib/useCloudSync.ts가 쓰는 경로와
// 반드시 일치해야 함(doc(db, 'users', uid)).
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
